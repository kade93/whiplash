<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 앱스토어 필수. 프로세스 목록은 샌드박스에서도 읽히고, ~/.claude 는 홈 폴더를 한 번 허락받아 북마크로 연다 -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- 몸으로 때리기: 카메라 손 휘두르기 · 입으로 「화츅」 (켤 때만) -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- 네트워크 권한은 싣지 않는다. 앱스토어판은 밖으로 나가는 연결도, 들어오는 연결도 없다
         (아이폰/워치 리모트와 남은 쿼터 조회는 소스 빌드판에만 있다). 2026-11 심사에서 network.server 가 걸렸다. -->
</dict>
</plist>
